import Proofs.GraphQL.IncrementalDelivery.WorkQueueImplementation.StartupItemPublicationReflection
import Proofs.GraphQL.IncrementalDelivery.WorkQueueImplementation.StartupProducedStreamCoverage
import Proofs.GraphQL.IncrementalDelivery.WorkQueueImplementation.StartupObjectPublicationAcceptance
import Proofs.GraphQL.IncrementalDelivery.WorkQueueImplementation.StartupStreamCompletion

/-! Every canonical object publication releases every stream generated by that object. -/

namespace GraphQL.IncrementalDelivery.ReferenceWorkQueue.ConformancePlan
open GraphQL.IncrementalDelivery.WorkQueueSemantics

-----------------------------------------------------------------------------------------
-- Raw successful carrier health applies to the exact canonical occurrence
-----------------------------------------------------------------------------------------

/-- Every stream generated by a canonical object atom occurs in actual raw notices.
Witness: register the same matched task at its raw release handler, recover its successful
source input, and use healthy retirement to force complete stream release. The publisher's
reported owner may differ from the raw carrier; the proof retains both without conflation.
-/
theorem Witness.startup_groupPublication_childStream_rawNotice
    {work inputs w index owner payload stream dependencies}
    (generated : ExecutedWork work) (startup : InitialStartup)
    (matched : startup.MatchesWork work) (valid : ValidGraphEvents work inputs.flatten)
    (started : inputsStarted work inputs startup = true)
    (history
      : let initial := State.initialize (Work.fromExecution work) startup
        w.events = initial.nonterminalAtoms inputs)
    (ledger
      : BufferedClosureLedger work inputs w
          (State.initialize (Work.fromExecution work) startup))
    (selected : w.events[index]? = some (.groupValues owner payload))
    (child : NodeAt work stream .stream dependencies (some (w.matching index)))
    : stream.ref
      ∈ (((State.initialize (Work.fromExecution work) startup)).rawBatches
          inputs).2.flatMap
          rawStreamNoticeRefs := by
  obtain ⟨origin⟩ := Witness.startup_groupPublication_origin startup started history selected
  obtain ⟨producer, known⟩ := Witness.startup_groupPublication_taskAt startup started history
      ledger selected origin
  have contributes := State.startup_rawBatches_publicationContributors startup valid
    origin.group origin.values origin.members.1 origin.value origin.members.2
  have atAtoms := origin.carrier
  rw [← State.runNormalized_rawBatches] at atAtoms
  obtain ⟨carrierIndex, carrier, _⟩ := publicationAtoms_groupSuccess_prefix _ atAtoms
  obtain ⟨_, _, retirement⟩ := generated.startup_runNormalized_successfulGroupRetirements
    startup matched valid started (List.mem_of_getElem? carrier)
  obtain ⟨earlier, batch, later, fifo, result, tail, node, split, batchEq, _, found⟩ :=
    Witness.startup_groupPublication_processed generated startup matched valid started history
        ledger selected
  exact generated.startup_success_retired_childStream_notice_forBatches startup matched valid
      started split batchEq found
    known contributes retirement.retired retirement.uncancelled child

-----------------------------------------------------------------------------------------
-- Public-history publication implies complete child notice coverage
-----------------------------------------------------------------------------------------

/-- Every structural stream generated by a published object is announced on the same witness.
Witness: provenance selects the producer's object atom; complete raw release survives
normalization unchanged. No child notice or release-order premise is supplied.
-/
theorem startup_objectProducedStream_noticed {work inputs w address stream dependencies}
    (generated : ExecutedWork work) (startup : InitialStartup)
    (matched : startup.MatchesWork work) (valid : ValidGraphEvents work inputs.flatten)
    (started : inputsStarted work inputs startup = true)
    (history
      : let initial := State.initialize (Work.fromExecution work) startup
        w.events = initial.nonterminalAtoms inputs)
    (admitted : PublicationAdmission work w)
    (ledger
      : BufferedClosureLedger work inputs w
          (State.initialize (Work.fromExecution work) startup))
    (known : NodeAt work stream .stream dependencies (some (.executionGroup address)))
    (published : Published w.matching w.events (.executionGroup address))
    : stream.ref ∈ w.events.flatMap streamNoticeRefs := by
  rw [Witness.startup_streamNotices_eq_raw startup valid history]
  obtain ⟨index, event, selected, value, same⟩ := published
  have exactValue := same ▸ admitted.publicationAt selected value
  cases event <;> try cases value
  case groupValues owner payload =>
    exact Witness.startup_groupPublication_childStream_rawNotice generated startup matched valid
        started history
      ledger selected (same.symm ▸ known)
  case streamValues node values groups streams =>
    cases values with
    | nil => cases exactValue
    | cons head tail =>
        cases tail with
        | cons next rest => cases exactValue
        | nil =>
            obtain ⟨owners, producer, impossible⟩ := exactValue
            obtain ⟨_, _, _, _, _, _, _, _, payload⟩ := impossible

/-- A stream generated by a published object completes at concrete termination.
Witness: complete object-child notice coverage followed by the existing terminal stream
tracking theorem on the unchanged canonical history and publication matching.
-/
theorem startup_terminal_objectProducedStream_completed
    {work inputs w address stream dependencies} (generated : ExecutedWork work)
    (startup : InitialStartup) (matched : startup.MatchesWork work)
    (valid : ValidGraphEvents work inputs.flatten)
    (started : inputsStarted work inputs startup = true)
    (history
      : let initial := State.initialize (Work.fromExecution work) startup
        w.events = initial.nonterminalAtoms inputs)
    (admitted : PublicationAdmission work w)
    (ledger
      : BufferedClosureLedger work inputs w
          (State.initialize (Work.fromExecution work) startup))
    (ended
      : let initial := State.initialize (Work.fromExecution work) startup
        (initial.runNormalized inputs).1.terminated = true)
    (known : NodeAt work stream .stream dependencies (some (.executionGroup address)))
    (published : Published w.matching w.events (.executionGroup address))
    : stream.ref ∈ completedRefs w.events :=
  startup_streamNoticeRefs_terminalCompleted startup valid history ended
    (List.mem_append_right _
      (startup_objectProducedStream_noticed generated startup matched valid started
        history admitted ledger known published))

end GraphQL.IncrementalDelivery.ReferenceWorkQueue.ConformancePlan
