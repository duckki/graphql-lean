import Proofs.GraphQL.IncrementalDelivery.WorkQueueAlternativeImpl.ReceiptPrefixAdmission

/-! A proof-side source producer / library Queue protocol at finite non-reentrant
boundaries. Push reserves before returning its wait; the sole producer awaits that wait
before its next serialized raw pull. Outstanding completion promises occupy FIFO slots.
This is not a hard bound on arbitrary callers of Queue.push or a native callback bridge.
-/

namespace GraphQL.IncrementalDelivery.AlternativeWorkQueue.NativeRefinement

-----------------------------------------------------------------------------------------
-- Original slots, serialized pull and producer wait (not wire-reader turns)
-----------------------------------------------------------------------------------------

inductive SourceSlot (value : Type) where
  | pending
  | fulfilled (result : value)
  | rejected
deriving Repr, DecidableEq

/-- entries counts reserved item slots, including unresolved completions. pulling counts
the one raw pull/item preparation before its push; waiting represents the producer's
returned push-wait promise, not the Queue's general multiple-producer waiter array.
-/
structure SourceBuffer (value : Type) where
  entries : List (SourceSlot value) := []
  pulling : Bool := false
  waiting : Bool := false
  closed : Bool := false
deriving Repr, DecidableEq

inductive SourceCreditAction (value : Type) where
  | beginPull
  | push (slot : SourceSlot value)
  | settle (index : Nat) (outcome : SourceSlot value)
  | take
  | acknowledge
  | finishSource
  | cancel
deriving Repr, DecidableEq

/-- The concrete producer's await/serialization obligations, not the desired capacity
inequality. Raw step deliberately does not reject pushes that violate these obligations.
-/
def SourceBuffer.Enabled (state : SourceBuffer value) : SourceCreditAction value → Prop
  | .beginPull => state.closed = false ∧ state.pulling = false ∧ state.waiting = false
  | .push _ => state.closed = false ∧ state.pulling = true
  | _ => True

/-- _reserve parks after insertion at the threshold. _drainBatch releases before yield;
_flush wakes the waiting producer below capacity. Receipt acknowledgement releases nothing.
finishSource leaves original slots intact; cancel clears them. Synthetic terminal-error entries
and arbitrary competing producers are outside this per-source original-slot abstraction.
-/
def SourceBuffer.step (budget : Nat) (state : SourceBuffer value)
    : SourceCreditAction value → SourceBuffer value × List value
  | .beginPull => ({ state with pulling := true }, [])
  | .push slot =>
      let entries := state.entries ++ [slot]
      (
        {
          state with
            entries, pulling := false, waiting := decide (budget ≤ entries.length)
        },
        []
      )
  | .settle index outcome =>
      let entries :=
        state.entries.modify index
          (fun slot =>
            match slot with
            | .pending => outcome
            | _ => slot)
      ({ state with entries }, [])
  | .take =>
      match state.entries with
      | .fulfilled result :: rest =>
          (
            {
              state with
                entries := rest,
                waiting := if rest.length < budget then false else state.waiting
            },
            [result]
          )
      | _ => (state, [])
  | .acknowledge => (state, [])
  | .finishSource => ({ state with pulling := false, closed := true }, [])
  | .cancel => (⟨[], false, false, true⟩, [])

def SourceBuffer.Legal (budget : Nat) (state : SourceBuffer value)
    : List (SourceCreditAction value) → Prop
  | [] => True
  | action :: rest =>
      state.Enabled action ∧ (state.step budget action).1.Legal budget rest

def SourceBuffer.run (budget : Nat) (state : SourceBuffer value)
    : List (SourceCreditAction value) → SourceBuffer value × List value
  | [] => (state, [])
  | action :: rest =>
      let next := state.step budget action
      let last := next.1.run budget rest
      (last.1, next.2 ++ last.2)

/-- Includes the next serialized pull, not merely fulfilled buffered outcomes. -/
def SourceBuffer.occupied (state : SourceBuffer value) : Nat :=
  state.entries.length + if state.pulling then 1 else 0

/-- The optimization target for every finite cooperating source-producer prefix. Waiting
is generated by reserve/release; the hypothesis does not assume a backlog inequality.
-/
def ContinuousSourceCreditSafety : Prop :=
  ∀ (value : Type) (budget : Nat),
    0 < budget
    → ∀ actions,
        ({} : SourceBuffer value).Legal budget actions
        → (({} : SourceBuffer value).run budget actions).1.occupied ≤ budget

-----------------------------------------------------------------------------------------
-- The returned wait derives the bound, including a raw pull awaiting its next push
-----------------------------------------------------------------------------------------

private def SourceBuffer.CreditInvariant (budget : Nat) (state : SourceBuffer value)
    : Prop :=
  state.occupied ≤ budget ∧ (state.waiting = false → state.entries.length < budget)

private theorem SourceBuffer.step_creditInvariant (budget : Nat) (positive : 0 < budget)
    (state : SourceBuffer value) (action : SourceCreditAction value)
    (invariant : state.CreditInvariant budget) (enabled : state.Enabled action)
    : (state.step budget action).1.CreditInvariant budget := by
  have before := invariant
  obtain ⟨bounded, unparked⟩ := invariant
  cases action with
  | beginPull =>
      obtain ⟨_, _, waiting⟩ := enabled
      have room := unparked waiting
      simp only [SourceBuffer.step, SourceBuffer.CreditInvariant, SourceBuffer.occupied,
        ↓reduceIte]
      exact ⟨by omega, unparked⟩
  | push slot =>
      obtain ⟨_, pulling⟩ := enabled
      simp only [SourceBuffer.occupied, pulling, ↓reduceIte] at bounded
      simp only [SourceBuffer.step, SourceBuffer.CreditInvariant, SourceBuffer.occupied,
        Bool.false_eq_true, ↓reduceIte, Nat.add_zero, List.length_append, List.length_singleton]
      exact ⟨bounded, by simp only [decide_eq_false_iff_not]; omega⟩
  | settle index outcome =>
      dsimp only [SourceBuffer.step, SourceBuffer.CreditInvariant, SourceBuffer.occupied]
      simpa only [SourceBuffer.CreditInvariant, SourceBuffer.occupied, List.length_modify] using before
  | take =>
      cases entries : state.entries with
      | nil => simpa only [SourceBuffer.step, entries] using before
      | cons head rest =>
          cases head with
          | pending => simpa only [SourceBuffer.step, entries] using before
          | rejected => simpa only [SourceBuffer.step, entries] using before
          | fulfilled result =>
              have room : rest.length < budget := by
                simp only [SourceBuffer.occupied, entries, List.length_cons] at bounded
                split at bounded <;> omega
              simp [SourceBuffer.step, entries, room, SourceBuffer.CreditInvariant, SourceBuffer.occupied]
              simp only [SourceBuffer.occupied, entries, List.length_cons] at bounded
              omega
  | acknowledge => exact And.intro bounded unparked
  | finishSource =>
      simp only [SourceBuffer.step, SourceBuffer.CreditInvariant, SourceBuffer.occupied,
        Bool.false_eq_true, ↓reduceIte, Nat.add_zero]
      refine ⟨?_, unparked⟩
      simp only [SourceBuffer.occupied] at bounded
      split at bounded <;> omega
  | cancel =>
      simp [SourceBuffer.step, SourceBuffer.CreditInvariant, SourceBuffer.occupied, positive]

private theorem SourceBuffer.run_creditInvariant (budget : Nat) (positive : 0 < budget)
    (state : SourceBuffer value) (actions : List (SourceCreditAction value))
    (invariant : state.CreditInvariant budget) (legal : state.Legal budget actions)
    : (state.run budget actions).1.CreditInvariant budget := by
  induction actions generalizing state with
  | nil => exact invariant
  | cons action rest ih =>
      exact ih _ (state.step_creditInvariant budget positive action invariant legal.1) legal.2

theorem ContinuousSourceCreditSafety_holds : ContinuousSourceCreditSafety := by
  intro value budget positive actions legal
  exact (SourceBuffer.run_creditInvariant budget positive {} actions
          (by simp [SourceBuffer.CreditInvariant, SourceBuffer.occupied, positive])
          legal).1

/-- Legality includes every prefix's await discipline, not just its final state. -/
theorem SourceBuffer.legal_take (budget : Nat) (state : SourceBuffer value)
    (actions : List (SourceCreditAction value)) (legal : state.Legal budget actions)
    (count : Nat)
    : state.Legal budget (actions.take count) := by
  induction count generalizing state actions with
  | zero => trivial
  | succ count ih =>
      cases actions with
      | nil => trivial
      | cons action rest => exact ⟨legal.1, ih _ _ legal.2⟩

/-- A paused consumer leaves a prefix state; its remaining window is still bounded. -/
theorem SourceBuffer.prefix_occupied_le (budget : Nat) (positive : 0 < budget)
    (actions : List (SourceCreditAction value))
    (legal : ({} : SourceBuffer value).Legal budget actions) (count : Nat)
    : (({} : SourceBuffer value).run budget (actions.take count)).1.occupied ≤ budget :=
  ContinuousSourceCreditSafety_holds value budget positive _
    (SourceBuffer.legal_take budget {} actions legal count)

-----------------------------------------------------------------------------------------
-- FIFO and credit release differ from adoption/finally acknowledgement
-----------------------------------------------------------------------------------------

/-- Out-of-order promise fulfilment cannot overtake an unsettled head in a live batch. -/
theorem SourceBuffer.take_pending_head (budget : Nat) (state : SourceBuffer value)
    (rest : List (SourceSlot value)) (pending : state.entries = .pending :: rest)
    : state.step budget .take = (state, []) := by
  simp [SourceBuffer.step, pending]

theorem SourceBuffer.acknowledge_identity (budget : Nat) (state : SourceBuffer value)
    : state.step budget .acknowledge = (state, []) :=
  rfl

/-- Credit is already released in the state associated with the yielded head, before
integration/handoff or receipt acknowledgement. No consumer-turn seal is introduced.
-/
theorem SourceBuffer.take_releases_before_yield (budget : Nat)
    (state : SourceBuffer value) (result : value) (rest : List (SourceSlot value))
    (entries : state.entries = .fulfilled result :: rest)
    (bounded : state.occupied ≤ budget)
    : (state.step budget .take).2 = [result]
      ∧ (state.step budget .take).1.occupied + 1 = state.occupied
      ∧ (state.step budget .take).1.waiting = false := by
  have room : rest.length < budget := by
    simp only [SourceBuffer.occupied, entries, List.length_cons] at bounded
    split at bounded <;> omega
  simp [SourceBuffer.step, entries, room, SourceBuffer.occupied]
  omega

/-- Refill can start before the next receipt acknowledgement or wire-reader turn, provided
the source is still open and has no serialized pull outstanding.
-/
theorem SourceBuffer.refill_before_acknowledgement (budget : Nat)
    (state : SourceBuffer value) (result : value) (rest : List (SourceSlot value))
    (entries : state.entries = .fulfilled result :: rest)
    (bounded : state.occupied ≤ budget) (live : state.closed = false)
    (idle : state.pulling = false)
    : (state.step budget .take).1.Enabled .beginPull := by
  have released := state.take_releases_before_yield budget result rest entries bounded
  exact ⟨
    by simp [SourceBuffer.step, entries, live],
    by simp [SourceBuffer.step, entries, idle],
    released.2.2
  ⟩

end GraphQL.IncrementalDelivery.AlternativeWorkQueue.NativeRefinement
