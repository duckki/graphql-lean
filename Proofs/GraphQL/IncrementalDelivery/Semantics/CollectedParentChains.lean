import Proofs.GraphQL.IncrementalDelivery.Semantics.CollectedAncestry

/-! Exact ordered parent chains generated by collection. The assignment is ghost state;
the public collector and its fresh-key supply are unchanged. Transitive ancestry alone
does not establish the suffix agreement required by native parent-pointer planning.
-/

namespace GraphQL.IncrementalDelivery.Semantics.ParentChains

open GraphQL.IncrementalDelivery.Execution
open Ancestry

attribute [local simp] id_pure_eq id_bind_eq id_map_eq run_bind run_map

def Chains (parents : Assignment) (bound : Nat) : Prop :=
  ∀ key < bound,
    ∀ front ancestor suffix,
      parents key = front ++ ancestor :: suffix
      → ancestor < bound ∧ parents ancestor = suffix

theorem chains_allocate (parents : Assignment) (state : Nat) (usage : Option DeferUsage)
    (_valid : Valid parents state) (chains : Chains parents state)
    (known : ∀ u ∈ usage, u.ref < state ∧ parents u.ref = u.ancestors)
    : Chains
        (allocate parents state ((usage.map (fun u => u.ref :: u.ancestors)).getD []))
        (state + 1) := by
  intro key bound front ancestor suffix chain
  by_cases fresh : key = state
  · subst key
    simp only [allocate, ↓reduceIte] at chain
    cases usage with
    | none => simp at chain
    | some usage =>
        obtain ⟨older, exactContext⟩ := known usage rfl
        simp only [Option.map_some, Option.getD_some] at chain
        cases front with
        | nil =>
            simp only [List.nil_append, List.cons.injEq] at chain
            obtain ⟨rfl, rfl⟩ := chain
            refine ⟨Nat.lt_succ_of_lt older, ?_⟩
            simp [allocate, Nat.ne_of_lt older, exactContext]
        | cons first rest =>
            simp only [List.cons_append, List.cons.injEq] at chain
            have context : parents usage.ref = rest ++ ancestor :: suffix := exactContext.trans chain.2
            obtain ⟨ancestorBound, ancestorContext⟩ := chains usage.ref older rest ancestor suffix context
            refine ⟨by omega, ?_⟩
            simp [allocate, Nat.ne_of_lt ancestorBound, ancestorContext]
  · have oldKey : key < state := by omega
    simp only [allocate, fresh, ↓reduceIte] at chain
    obtain ⟨ancestorBound, ancestorContext⟩ := chains key oldKey front ancestor suffix chain
    refine ⟨by omega, ?_⟩
    simp [allocate, Nat.ne_of_lt ancestorBound, ancestorContext]

def Collected (parents : Assignment) (start : Nat) (context : DeferMap)
    (path : ResponsePath) (output : FieldCollection × Nat)
    : Prop :=
  start ≤ output.2
  ∧ ∃ next,
      Extends start parents next
      ∧ Valid next output.2
      ∧ Chains next output.2
      ∧ MapAt next output.2 (getNewDeferMap output.1.newDeferUsages path context)
      ∧ GroupsSatisfy
          (fun field =>
            OptionalUsageAt next output.2
              (getNewDeferMap output.1.newDeferUsages path context) field.deferUsage)
          output.1.collectedFieldsMap

theorem collected_empty (parents : Assignment) (state : Nat) (context : DeferMap)
    (path : ResponsePath) (valid : Valid parents state) (chains : Chains parents state)
    (metadata : MapAt parents state context)
    : Collected parents state context path ({}, state) :=
  ⟨
    Nat.le_refl _,
    parents,
    Extends.refl _ _,
    valid,
    chains,
    metadata,
    by simp [GroupsSatisfy]
  ⟩

theorem collected_append {first middle : Assignment} {start mid finish : Nat}
    {context : DeferMap} {path : ResponsePath} {left right : FieldCollection}
    (hle : start ≤ mid) (extended : Extends start first middle)
    (fields
      : GroupsSatisfy
          (fun field =>
            OptionalUsageAt middle mid
              (getNewDeferMap left.newDeferUsages path context) field.deferUsage)
          left.collectedFieldsMap)
    (later
      : Collected middle mid (getNewDeferMap left.newDeferUsages path context) path
          (right, finish))
    : Collected first start context path (left.append right, finish) := by
  obtain ⟨tailLe, next, tailExt, valid, chains, metadata, known⟩ := later
  refine ⟨Nat.le_trans hle tailLe, next, extended.trans tailExt hle, valid, chains, ?_, ?_⟩
  · simpa only [FieldCollection.append, getNewDeferMap_append] using metadata
  · simp only [FieldCollection.append, getNewDeferMap_append]
    apply groupsSatisfy_merge _ _ _ _ known
    intro group member field present
    exact (fields group member field present).extend tailExt tailLe (getNewDeferMap_keeps_refs _ _ _)

mutual
  theorem collectSelection_chains (schema : Schema) (variables : VariableValues)
      (parentType : Name) (source : ResolverValue ObjectRef) (selection : Selection)
      (usage : Option DeferUsage) (parents : Assignment) (state : Nat)
      (context : DeferMap) (path : ResponsePath) (valid : Valid parents state)
      (chains : Chains parents state) (metadata : MapAt parents state context)
      (known : OptionalUsageAt parents state context usage)
      : Collected parents state context path
          ((collectSelection schema variables parentType source usage selection).run
            state) := by
    cases selection with
    | field name fieldName arguments directives children =>
        cases ha : selectionDirectivesAllowBool variables directives
        · simpa [collectSelection, ha] using collected_empty parents state context path valid chains metadata
        · simp only [collectSelection, ha, Bool.not_true, Bool.false_eq_true, ↓reduceIte,
            StateT.run_pure, id_pure_eq]
          exact ⟨Nat.le_refl _, parents, Extends.refl _ _, valid, chains, metadata,
            by simpa [GroupsSatisfy, getNewDeferMap] using known⟩
    | inlineFragment condition directives children =>
        cases ha : selectionDirectivesAllowBool variables directives
        · simpa [collectSelection, ha] using collected_empty parents state context path valid chains metadata
        · cases ht : condition.all (doesFragmentTypeApplyBool schema parentType source)
          · simpa [collectSelection, ha, ht] using collected_empty parents state context path valid chains metadata
          · cases hd : activeDefer? variables directives with
            | none =>
                simpa [collectSelection, ha, ht, hd] using collectFields_chains schema variables
                  parentType source children usage parents state context path valid chains metadata known
            | some label =>
                let ancestors := (usage.map (fun parent => parent.ref :: parent.ancestors)).getD []
                let fresh : DeferUsage := { ref := state, label, ancestors }
                let next := allocate parents state ancestors
                let nextMap := getNewDeferMap [fresh] path context
                have hm := mapAt_allocate parents state path context usage label metadata known
                have hv : Valid next (state + 1) := allocate_valid parents state usage valid
                  (fun u hu => ⟨(known u hu).1, (known u hu).2.1⟩)
                have hc : Chains next (state + 1) := chains_allocate parents state usage valid chains
                  (fun u hu => ⟨(known u hu).1, (known u hu).2.1⟩)
                obtain ⟨hle, final, he, finalValid, finalChains, finalMap, finalFields⟩ :=
                  collectFields_chains schema variables parentType source children (some fresh)
                    next (state + 1) nextMap path hv hc hm.1 (by intro u hu; cases hu; exact hm.2)
                simp only [collectSelection, ha, Bool.not_true, Bool.false_eq_true, ↓reduceIte,
                  ht, hd, freshNodeRef, run_bind, StateT.run_pure, id_pure_eq,
                  StateT.run_get, StateT.run_set]
                refine ⟨Nat.le_trans (Nat.le_succ state) hle, final,
                  (allocate_extends parents state ancestors).trans he (Nat.le_succ state),
                  finalValid, finalChains, ?_, ?_⟩
                · simpa only [nextMap, fresh, ancestors, getNewDeferMap, List.foldl_cons, List.foldl_nil] using finalMap
                · simpa only [nextMap, fresh, ancestors, getNewDeferMap, List.foldl_cons, List.foldl_nil] using finalFields
  termination_by sizeOf selection

  theorem collectFields_chains (schema : Schema) (variables : VariableValues)
      (parentType : Name) (source : ResolverValue ObjectRef) (selections : List Selection)
      (usage : Option DeferUsage) (parents : Assignment) (state : Nat)
      (context : DeferMap) (path : ResponsePath) (valid : Valid parents state)
      (chains : Chains parents state) (metadata : MapAt parents state context)
      (known : OptionalUsageAt parents state context usage)
      : Collected parents state context path
          ((collectFields schema variables parentType source selections usage).run
            state) := by
    cases selections with
    | nil =>
        simpa [collectFields] using collected_empty parents state context path valid chains metadata
    | cons selection rest =>
        obtain ⟨hle, next, he, hv, hc, hm, hf⟩ := collectSelection_chains schema variables parentType
          source selection usage parents state context path valid chains metadata known
        have tail := collectFields_chains schema variables parentType source rest usage next
          ((collectSelection schema variables parentType source usage selection).run state).2
          _ path hv hc hm (known.extend he hle (getNewDeferMap_keeps_refs _ _ _))
        simp only [collectFields, run_bind, StateT.run_pure, id_pure_eq]
        exact collected_append hle he hf tail
  termination_by sizeOf selections
end

theorem collectSubfields_chains (schema : Schema) (variables : VariableValues)
    (parentType : Name) (source : ResolverValue ObjectRef) (fields : List FieldDetails)
    (parents : Assignment) (state : Nat) (context : DeferMap) (path : ResponsePath)
    (valid : Valid parents state) (chains : Chains parents state)
    (metadata : MapAt parents state context)
    (known : ∀ field ∈ fields, OptionalUsageAt parents state context field.deferUsage)
    : Collected parents state context path
        ((collectSubfields schema variables parentType source fields).run state) := by
  induction fields generalizing parents state context with
  | nil =>
      simpa [collectSubfields] using collected_empty parents state context path valid chains metadata
  | cons field rest ih =>
      obtain ⟨hle, next, he, hv, hc, hm, hf⟩ := collectFields_chains schema variables parentType source
        field.selectionSet field.deferUsage parents state context path valid chains metadata (known field (by simp))
      have tail := ih next _ _ hv hc hm (fun f hf =>
        (known f (List.mem_cons_of_mem field hf)).extend he hle (getNewDeferMap_keeps_refs _ _ _))
      simp only [collectSubfields, run_bind, StateT.run_pure, id_pure_eq]
      exact collected_append hle he hf tail

end GraphQL.IncrementalDelivery.Semantics.ParentChains
