-----------------------------------------------------------------------------------------
-- Generated work, legal source settlements, and the actual remapped value
-----------------------------------------------------------------------------------------

private def successRoot : DeliveryNode := ⟨0, [], some (.string "S")⟩
private def failureRoot : DeliveryNode := ⟨1, [], some (.string "F")⟩
private def parent : DeliveryNode := ⟨2, [], some (.string "P")⟩
private def shallow : DeliveryNode := ⟨3, [], some (.string "D")⟩
private def deep : DeliveryNode := ⟨4, [.field "user"], some (.string "C")⟩

private def sharedTask : Occurrence := .executionGroup [0, 0, 1, 0]
private def failedTask : Occurrence := .executionGroup [0, 0, 1, 1, 0]
private def blockerTask : Occurrence := .executionGroup [1, 0]
private def parentTask : Occurrence := .executionGroup [1, 1, 0]

private def emptyChildren : Execution.Work := .combine .empty .empty

private def sharedValue : ExecutionGroupValue :=
  {
    deliveryGroups := [successRoot, shallow, deep],
    path := [.field "user"],
    data := [("name", .scalar "name1")]
  }

private def parentValue : ExecutionGroupValue :=
  { deliveryGroups := [parent], path := [], data := [("b", .scalar "b")] }

private def work : Execution.Work :=
  .combine
    (.combine
      (.combine .empty
        (.combine
          (.executionGroup [⟨successRoot, []⟩, ⟨shallow, [parent]⟩, ⟨deep, [parent]⟩]
            [.field "user"] (.ok (sharedValue.data, 0)) emptyChildren)
          (.combine
            (.executionGroup [⟨failureRoot, []⟩, ⟨deep, [parent]⟩]
              [.field "user"] (.error 1) .empty)
            .empty)))
      .empty)
    (.combine
      (.executionGroup [⟨successRoot, []⟩] [] (.ok ([("a", .scalar "a")], 0))
        emptyChildren)
      (.combine
        (.executionGroup [⟨parent, []⟩] [] (.ok (parentValue.data, 0)) emptyChildren)
        .empty))

private def failed : GraphEvent := .taskFailure failedTask 1
private def shared : GraphEvent := .taskSuccess sharedTask ⟨sharedValue, {}⟩
private def finish : GraphEvent := .taskSuccess parentTask ⟨parentValue, {}⟩
private def inputs : List (List GraphEvent) := [[failed, shared, finish]]

private def outputs : List WorkQueueEvent :=
  [
    .groupFailure failureRoot 1,
    .groupValues parent [parentValue],
    .groupSuccess parent [shallow, deep] [],
    .groupValues deep [sharedValue],
    .groupSuccess shallow [] [],
    .groupFailure deep 1
  ]

/-- The counterexample is generated by the existing finite pure query executor.
Witness: an initially selected user object, a shared success under S/D/C, a shared
non-null failure under F/C, and P's independent field. S's blocker retains the success
until P releases D before the already-failed, deeper C.
-/
theorem generated : ExecutedWork work := by
  refine ⟨Nat, schema, resolvers, [], 50, "Query", .object "Query" 0,
    [field "user" [field "name" [] [.skip (.boolean true)]],
      defer [field "user" [field "name"], field "a"] (some "S"),
      defer [field "user" [field "required"]] (some "F"),
      defer [field "b", defer [field "user" [field "name"]] (some "D"),
        field "user" [defer [field "name", field "required"] (some "C")]] (some "P")], ?_⟩
  cbv

private theorem shared_known
    : TaskAt work sharedTask
        [successRoot.key, shallow.key, deep.key] none
        (.object sharedValue.path (.ok (sharedValue.data, 0))) :=
  ⟨_, _, _, emptyChildren, [], by cbv, rfl, rfl⟩

private theorem failed_known
    : TaskAt work failedTask [failureRoot.key, deep.key] none
        (.object [.field "user"] (.error 1)) :=
  ⟨_, _, _, .empty, [], by cbv, rfl, rfl⟩

private theorem blocker_known
    : TaskAt work blockerTask [successRoot.key] none
        (.object [] (.ok ([("a", .scalar "a")], 0))) :=
  ⟨_, _, _, emptyChildren, [], by cbv, rfl, rfl⟩

private theorem parent_known
    : TaskAt work parentTask [parent.key] none (.object [] (.ok (parentValue.data, 0))) :=
  ⟨_, _, _, emptyChildren, [], by cbv, rfl, rfl⟩

/-- All three inputs have exact outcomes, fresh identities, and actual requested starts.
Witness: structural descriptors and direct evaluation of the unchanged start checker;
all tasks are root-generated, so no producer success is assumed without evidence.
-/
theorem source_valid_started
    : ValidGraphEvents work inputs.flatten ∧ inputsStarted work inputs = true := by
  have first : ValidGraphEvents work [failed] :=
    .append .nil ⟨_, _, _, failed_known⟩
      (by simp [failed, GraphEvent.Fresh, GraphEvent.identities])
      ⟨_, _, _, failed_known, by intro source impossible; cases impossible⟩
  have second : ValidGraphEvents work [failed, shared] :=
    .append first ⟨_, _, shared_known, by cbv, by cbv⟩
      (by simp [failed, shared, failedTask, sharedTask, GraphEvent.Fresh, GraphEvent.identities])
      ⟨_, _, _, shared_known, by intro source impossible; cases impossible⟩
  refine ⟨.append second ⟨_, _, parent_known, by cbv, by cbv⟩ ?_ ?_, by cbv⟩
  · simp [failed, shared, finish, failedTask, sharedTask, parentTask,
      GraphEvent.Fresh, GraphEvent.identities]
  · exact ⟨_, _, _, parent_known, by intro source impossible; cases impossible⟩

/-- The raw healthy D publication is reassigned to C before C's failure completion.
Witness: direct execution of the original queue and publisher. C was announced by P's
carrier, so its longer response path wins despite its earlier accepted failure.
-/
theorem actual_output
    : ((State.initialize (Work.fromExecution work)).runNormalized inputs).2
      = [outputs] := by cbv

/-- The raw queue uses healthy D; only the publisher changes the effective owner to C.
Witness: the source prefix retains C's error and D's settled success, and the final raw
handler emits the shared value under D. These are concrete executable-state checks.
-/
theorem raw_support_and_failed_candidate
    : (((State.initialize (Work.fromExecution work)).replayGraphEvents
          [failed, shared]).groupNode?
          deep.key).map
          GroupNode.failure
        = some (some 1)
      ∧ (((State.initialize (Work.fromExecution work)).replayGraphEvents
            [failed, shared]).groupNode?
          shallow.key).map
          (fun node => (node.pending, node.failure))
        = some (0, none)
      ∧ ((State.initialize (Work.fromExecution work)).handleGraphEvents
          inputs.flatten).2[3]?
        = some (.groupValues shallow [sharedValue]) := by
  constructor
  · cbv
  constructor <;> cbv

