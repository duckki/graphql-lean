-- The selected wire owner really has failed before the shared publication
-----------------------------------------------------------------------------------------

private theorem task_cases {occurrence owners producer payload}
    (known : TaskAt work occurrence owners producer payload)
    : occurrence = sharedTask
      ∨ occurrence = failedTask
      ∨ occurrence = blockerTask
      ∨ occurrence = parentTask := by
  have member := known.observationToken
  simpa [observationTokens, work, emptyChildren, sharedTask, failedTask, blockerTask,
    parentTask] using member

private theorem first_count {failures}
    (counts : NodeErrors work failures failureRoot.key 1)
    : failedTask ∈ failures := by
  apply Classical.byContradiction
  intro absent
  obtain ⟨contribution, known, total⟩ := counts
  have zero : ∀ occurrence ∈ failures, contribution occurrence = 0 := by
    intro occurrence member
    obtain ⟨owners, producer, payload, task, assigned⟩ := known occurrence member
    rcases task_cases task with rfl | rfl | rfl | rfl
    · obtain ⟨rfl, _, rfl⟩ := task.unique shared_known
      simpa [failureRoot, successRoot, shallow, deep] using assigned
    · exact False.elim (absent member)
    · obtain ⟨rfl, _, rfl⟩ := task.unique blocker_known
      simpa [failureRoot, successRoot] using assigned
    · obtain ⟨rfl, _, rfl⟩ := task.unique parent_known
      simpa [failureRoot, parent] using assigned
  have sumZero : (failures.map contribution).sum = 0 := by
    apply List.sum_eq_zero_iff_forall_eq_nat.mpr
    intro count member
    obtain ⟨occurrence, included, rfl⟩ := List.mem_map.mp member
    exact zero occurrence included
  omega

/-- The earlier reported shared failure reaches C before its remapped value.
Witness: F's one error forces the shared F/C failure at cut zero. This remains true under
the revised contract; the publication must use a different healthy supporter.
-/
theorem selected_owner_already_failed (matching : PublicationMatching)
    (failures : FailureCuts)
    (first
      : EventAllowed work (ConformancePlan.initialKeys work) matching [] failures
          (.groupFailure failureRoot 1))
    : NodeFailed work matching (outputs.take 3) failures deep.key := by
  have recorded : failedTask ∈ failedBefore failures 0 := by
    apply first_count
    simpa only [EventAllowed, List.length_nil, failedBefore_filter _ (Nat.le_refl _)]
      using first.2.2.2
  apply NodeFailed.task failed_known (by simp)
  exact failedBefore_subset failures (Nat.zero_le _) recorded

